rity", "platform", "governance"], "keywords": ["SSO security SaaS", "SAML vulnerability", "staff impersonation SaaS", "support access controls", "GitBook breach SSO", "integration token security", "UK Software Security Code of Practice", "B2B SaaS security UK", "session security", "fractional CTO United Kingdom"], "faq": [["Why is a SaaS company's SSO flow a high-value target?", "Because a flaw there can let an attacker create sessions as any user, including staff with broad access. If staff sessions can reach integrations and keys, one login bug can lead to production, as GitBook's November 2026 incident showed."], ["How should support staff access customer accounts?", "Through a separate staff identity with phishing-resistant MFA, using just-in-time access that is approved, time-limited, logged and, where customers require it, consented to, rather than standing access to every workspace."], ["What is the UK Software Security Code of Practice?", "A voluntary code published by the UK government and NCSC in May 2025 setting baseline security principles for software vendors, including secure development, secure build environments and communicating with customers about incidents."]], "related": ["/fractional-cto-united-kingdom/", "/fractional-cto/", "/ai-architect/"], "citations": [{"title": "GitBook security incident, November 2026", "url": "https://gitbook.com/status/security-incident-2026-11-03", "publisher": "GitBook", "date": "Nov 2026"}, {"title": "This Week In Security: Four-Digit Patch Tuesday, SSH Exploited, GitBook Breach, Android GhostMap", "url": "https://hackaday.com/2026/11/13/this-week-in-security-four-digit-patch-tuesday-ssh-exploited-gitbook-breach-android-ghostmap/", "publisher": "Hackaday", "date": "13 Nov 2026"}, {"title": "Apify Confirms Customer Data Accessed in Cyberattack", "url": "https://www.securityweek.com/apify-confirms-customer-data-accessed-in-cyberattack/", "publisher": "SecurityWeek", "date": "13 Nov 2026"}, {"title": "Software Security